# filtr Production Environment Configuration
PORT=8080
BIND_IP=0.0.0.0
SSL_ENABLED=false
SSL_PORT=8443
SSL_DOMAIN=localhost
SSL_REDIRECT=true
FILTR_IMAGE=ghcr.io/kisa-ops/filtr:v4.1.3

# Pluggable AI / Deep NER Detection Engine (Microsoft Presidio)
# Mode: local (Docker sidecar) | remote (external hardware) | disabled
PRESIDIO_ENABLED=false
PRESIDIO_MODE=local
PRESIDIO_URL=http://presidio:5001
PRESIDIO_CONFIDENCE_THRESHOLD=0.6
# Activate local sidecar container when PRESIDIO_MODE=local:
# COMPOSE_PROFILES=ner

# Zero-Leak AI Incident Analytics Platform (LogOps)
# Activate companion platform with: COMPOSE_PROFILES=logops (or COMPOSE_PROFILES=ner,logops)
LOGOPS_PORT=8888
LOGOPS_IMAGE=ghcr.io/kisa-ops/logops:v1.0.0
LLM_URL=http://host.docker.internal:11434
LLM_MODEL=deepseek-r1:8b
