    "flags": "i",
    "replacementTemplate": "[TELEMATICS_DEVICE_ID_{INDEX}]",
    "enabled": true,
    "isCustom": false,
    "severity": "medium",
    "examples": [
      "OBD-II ID: 864920039182736",
      "telematics imei: 359182049182736",
      "telematics device = 'DEV981240192834'"
    ]
  },
  {
    "id": "ins_sepa_mandate_umr",
