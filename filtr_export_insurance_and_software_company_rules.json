  {
    "id": "ins_beneficiary_ssn_split",
    "name": "Life Insurance Beneficiary Allocation Details",
    "category": "pii",
    "description": "Matches designated life insurance beneficiary names associated with allocation percentages.",
    "pattern": "(?:primary|contingent)?\\s*beneficiary\\s*[:=\\-]\\s*([A-Za-z\\s.]+)\\s*[,;]?\\s*(?:share|percent|allocation|%)\\s*[:=\\-]?\\s*([0-9]{1,3}%?)",
    "flags": "i",
    "replacementTemplate": "beneficiary: [BENEFICIARY_NAME_{INDEX}], allocation: [ALLOCATION_PCT_{INDEX}]",
    "enabled": true,
    "isCustom": false,
    "severity": "critical",
    "examples": [
      "Primary Beneficiary: Jane Doe, Share: 50%",
      "beneficiary = Robert Smith; percent: 100%",
      "Contingent Beneficiary: Michael Brown, allocation: 25%"
    ]
  },
  {
    "id": "ins_loss_adjuster_payout",
    "name": "Claim Settlement Reserve & Payout Amount",
    "category": "financial",
    "description": "Matches confidential claim reserve limits, approved settlement figures, and loss adjuster valuations.",
    "pattern": "(?:settlement\\s*amount|claim\\s*reserve|approved\\s*payout|loss\\s*estimate)\\s*[:=\\-]?\\s*([$€£AEDSAR\\s]*[0-9]{1,3}(?:,[0-9]{3})*(?:\\.[0-9]{2})?)",
    "flags": "i",
    "replacementTemplate": "settlement: [CLAIM_PAYOUT_AMOUNT_{INDEX}]",
    "enabled": true,
    "isCustom": false,
    "severity": "high",
    "examples": [
      "Settlement Amount: $145,000.00",
      "claim reserve = €35,000.00",
      "Approved Payout: SAR 95,000.00"
    ]
  },
