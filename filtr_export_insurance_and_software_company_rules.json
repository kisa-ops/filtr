    "pattern": "(?:npn(?:\\s*number|\\s*#)?|producer(?:\\s*id|\\s*number)?|agent(?:\\s*npn|\\s*license))\\s*[:=\\-]?\\s*\\b([0-9]{7,10})\\b",
