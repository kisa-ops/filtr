    ]
  },
  {
    "id": "ins_underwriting_score",
    "name": "Underwriting Risk Class & Mortality Rating",
    "category": "financial",
    "description": "Matches confidential underwriting classifications, risk scores, and mortality adjustment factors.",
    "pattern": "(?:underwriting\\s*class|risk\\s*score|mortality\\s*rating)\\s*[:=\\-]?\\s*(?:Class\\s+[A-Z0-9]+|Preferred\\s+Plus|Standard\\s+Smoker|Substandard\\s+Table\\s+[A-Z0-9]+|\\b[0-9]{2,3}(?:\\.[0-9]+)?%?\\b)",
    "flags": "i",
    "replacementTemplate": "[UNDERWRITING_RISK_{INDEX}]",
    "enabled": true,
    "isCustom": false,
    "severity": "high",
    "examples": [
      "Underwriting Class: Preferred Plus",
      "risk score: 785",
      "mortality rating = Substandard Table B"
    ]
  },
  {
    "id": "ins_telematics_obd_id",
    "name": "Vehicle Telematics & OBD-II Tracker Device ID",
    "category": "pii",
    "description": "Matches connected vehicle OBD-II dongle IDs and telematics serial numbers in usage-based auto insurance.",
