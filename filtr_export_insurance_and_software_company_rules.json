    "category": "phi",
    "description": "Matches 10 or 11-digit National Drug Code (NDC) numbers used in prescription drug insurance claims.",
    "pattern": "(?:ndc(?:\\s*code)?|rx(?:\\s*ndc)?)\\s*[:=\\-]?\\s*\\b([0-9]{4,5}-[0-9]{3,4}-[0-9]{1,2})\\b",
    "flags": "i",
    "replacementTemplate": "[NDC_DRUG_CODE_{INDEX}]",
    "enabled": true,
    "isCustom": false,
    "severity": "high",
    "examples": [
      "NDC: 00002-1433-80",
      "NDC Code: 50580-449-01",
      "rx: 00069-3150-83"
    ]
  },
  {
